# ─────────────────────────────────────────────────────────────────────────────
# WCWAA Scout Pipeline — Git Ignore
# ─────────────────────────────────────────────────────────────────────────────

# ── Real data (game files, PDFs, rosters, logs, GC session tokens) ──────────
# Everything under data/real/ is machine-local and never committed.
data/real/

# ── Scratch / throwaway (mockups, proofs of concept) ─────────────────────
dev/tmp/

# ── Legacy data folders (pre-v3.0.0 locations) ─────────────────────────
Majors/
Minors/
Wild/
Storm/
Coach_Pitch/

# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.egg-info/
build/
dist/

# ── Virtual environment ──────────────────────────────────────────────────────
venv/
.venv/

# ── Logs (unified under logs/ in v3.0.0+) ───────────────────────────────────
logs/

# ── Session / credentials (GC auth tokens — never commit these) ─────────────
sessions/

# ── Generated HTML reports ───────────────────────────────────────────────────
src/web/stat_analysis_report.html

# ── Backup files ─────────────────────────────────────────────────────────────
*.bak
*.py.bak

# ── macOS ────────────────────────────────────────────────────────────────────
.DS_Store
